# Copy to .env (or run: bash setup.sh). Never commit real keys.
SUPABASE_URL=
SUPABASE_KEY=

# Database connection string used only for schema migrations. Get it from
# Supabase: Connect > Session pooler (or Direct connection if available).
# Set this in Railway too, so migrations run before each backend deployment.
SUPABASE_DB_URL=

# Browser URLs permitted to call the FastAPI service (comma-separated if needed).
CORS_ORIGINS=http://localhost:3000

# Used by browser code. In Vercel, set this to your public Railway API URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used by Next.js server-side API rewrites. Docker Compose uses the internal service name.
BACKEND_URL=http://backend:8000

# Railway provides PORT automatically. Docker Compose uses 8000 locally.
PORT=8000
