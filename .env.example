# Participant configuration. Import the file supplied by the organiser.
# All values are read by server routes; no browser database access.
SUPABASE_URL=
SUPABASE_KEY=
# Restricted PostgreSQL login, never the team's administrator connection.
SUPABASE_DB_URL=
# Required assigned schema, e.g. prototype_0123456789abcdef. Never public.
SUPABASE_SCHEMA=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_EMAIL=
SUPABASE_STORAGE_PASSWORD=
# Optional local browser port. Codespaces uses its forwarded port 3000 instead.
# Use 3001 locally if another app already uses 3000.
BOARDIQ_PORT=3000
