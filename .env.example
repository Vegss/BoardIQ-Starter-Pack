# Copy to .env (or let your AI assistant run bash setup.sh). Never commit real keys.
# These values are read by Next.js server routes only, never browser code.
SUPABASE_URL=
SUPABASE_KEY=

# Database connection string used only for schema migrations. Get it from
# Supabase: Connect > Session pooler (or Direct connection if available).
# Set this in Vercel too, so migrations run before each production build.
SUPABASE_DB_URL=
