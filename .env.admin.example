# Team-only provisioning settings. Copy to .env.admin; never distribute it.
SUPABASE_URL=
# Publishable key, included in each participant's private configuration.
SUPABASE_KEY=
# Supabase API administrator key: used only by the provisioning command.
SUPABASE_SERVICE_ROLE_KEY=
# Same project's administrator PostgreSQL connection (Connect > Session pooler).
SUPABASE_DB_URL=
